# =============================================================================
# NEXA — STAGING (open-beta smoke) template — NO REAL SECRETS
# Copy to the staging host secret store / server-only `.env`. NEVER commit filled values.
# Do NOT point DNS of the public beta domain here without explicit permission.
# Do NOT copy values from a developer `.env` into git.
#
# Docs: docs/STAGING_DEPLOYMENT.md | docs/OPEN_BETA_READINESS.md
# Platform examples: deploy/render-staging.example.yaml | deploy/railway.env.example
# Local dry-run compose: docker-compose.staging.example.yml
#
# Incompatible: root render.yaml (Free / ephemeral / mock / skip-email).
# =============================================================================

NEXA_PUBLIC_BETA=true
ENVIRONMENT=production
NEXA_STORAGE_MODE=persistent
LOG_LEVEL=INFO
APP_NAME=NEXA AI (staging)

TOKENS_ENFORCE=true
# Set true only after staging edge/WAF distributed limits are configured.
TRUSTED_EDGE_RATE_LIMIT_ENABLED=false
AUTH_SINGLE_USER=false
AUTH_SKIP_EMAIL_VERIFICATION=false
AUTH_BOOTSTRAP_FIRST_OWNER=false
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax
AUTH_SESSION_TTL_SECONDS=7776000
AUTH_SESSION_COOKIE_NAME=nexa_session

# Staging HTTPS origin (no trailing slash) — replace before deploy
AUTH_PUBLIC_BASE_URL=https://staging.YOUR_DOMAIN
CORS_ALLOWED_ORIGINS=https://staging.YOUR_DOMAIN
BILLING_PUBLIC_BASE_URL=https://staging.YOUR_DOMAIN

MEMORY_BACKEND=sql
# Prefer a dedicated staging DB / volume — never share production data
DATABASE_URL=sqlite:///data/nexa-staging.db

# --- Email (BLOCKER if unset — console is refused under NEXA_PUBLIC_BETA) -----
EMAIL_PROVIDER=smtp
EMAIL_FROM=noreply@YOUR_DOMAIN
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# --- Named model only (mock + openrouter/free refused at startup) -------------
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Or: AI_PROVIDER=openai / anthropic / gemini with matching *_API_KEY + *_MODEL
ALLOW_MODEL_FALLBACK=false
REQUEST_TIMEOUT_SECONDS=90
NEXA_AI_KILL_SWITCH=false

# --- Concurrency / spend (keep low on staging) --------------------------------
AGENT_MAX_PARALLEL_PER_USER=2
AGENT_MAX_STEPS=10
API_RATE_LIMIT_PER_MINUTE=60
REGISTER_RATE_LIMIT_PER_HOUR=20
FREE_TIER_MODE=false
WORKFLOWS_ENABLED=false

# --- Paths (mount a staging-only volume) --------------------------------------
AUTH_STORE_PATH=data/auth_store.json
TOKEN_STORE_PATH=data/token_store.json
PROFILE_STORE_PATH=data/profile_store.json
BILLING_STORE_PATH=data/billing_store.json
AGENT_WORKSPACE_DIR=agent_workspace
ATTACHMENT_STORAGE_DIR=data/attachments_tmp

# MUST stay unset / 0 on staging cloud hosts:
# NEXA_LOCAL_DESKTOP=
# NEXA_ELECTRON_ALLOW_LAN_BIND=
# NEXA_ALLOW_PACKAGED_DEVTOOLS=

WEB_SEARCH_PROVIDER=duckduckgo
IMAGE_PROVIDER=none
VIDEO_PROVIDER=none
