# NEXA AI - environment configuration
# Copy this file to `.env` and fill in the values you need.
# Never commit your real `.env` file or any API keys.
# --- Provider selection -------------------------------------------------
# One of: mock, openai, anthropic, local  (future: nexa)
AI_PROVIDER=mock
# --- OpenAI ---------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# --- Anthropic --------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
# --- Local model (self-hosted / Ollama-compatible server) -------------------
# AI_PROVIDER=local and AI_PROVIDER=ollama both use this server.
# local keeps the original provider name; ollama is the same protocol.
LOCAL_MODEL_URL=http://localhost:11434
LOCAL_MODEL_NAME=llama3.2:3b
# --- Model gateway (Part 7A) ------------------------------------------------
# MODEL_SELECTION: empty = pin AI_PROVIDER's model; "auto" = pick by task.
# ALLOW_MODEL_FALLBACK: true = on a temporary provider error, try another
# configured model and tell the client which one answered.
# Catalog ids (cloud): gpt-4o, gpt-4o-mini, gpt-4.1-mini,
# claude-opus-4-20250514, claude-sonnet-4-20250514, claude-3-5-haiku-latest.
# Keys stay in this file / the environment. They are never sent to the UI.
MODEL_SELECTION=
ALLOW_MODEL_FALLBACK=false
# --- Application ------------------------------------------------------------
APP_NAME=NEXA AI
ENVIRONMENT=development
LOG_LEVEL=INFO
MAX_MESSAGE_LENGTH=4000
REQUEST_TIMEOUT_SECONDS=30
# --- Memory (Part 2) ----------------------------------------------------
MEMORY_STORE_PATH=data/memory_store.json
MEMORY_SEARCH_LIMIT=10
# --- Tools / filesystem sandbox (Part 2) ---------------------------------
# All FileRead/FileWrite/DirectoryList operations are confined to this
# directory (created automatically). Path traversal outside of it is blocked.
AGENT_WORKSPACE_DIR=agent_workspace
MAX_FILE_READ_BYTES=1000000
# --- Agent (Part 2) --------------------------------------------------------
AGENT_MAX_STEPS=10
AGENT_TIMEOUT_SECONDS=30
AGENT_ERROR_LIMIT=3
# --- Web research (Part 3) --------------------------------------------------
# One of: mock, http, duckduckgo. "duckduckgo" uses DuckDuckGo Lite (no API key
# needed); "http" calls a generic JSON search API you configure below.
WEB_SEARCH_PROVIDER=duckduckgo
SEARCH_API_URL=
SEARCH_API_KEY=
WEB_FETCH_TIMEOUT_SECONDS=10
WEB_MAX_PAGE_SIZE_BYTES=2000000
WEB_MAX_SEARCH_RESULTS=5
WEB_MAX_REDIRECTS=3
# --- Vision (Part 3) ---------------------------------------------------------
# One of: mock, openai (requires OPENAI_API_KEY above).
VISION_PROVIDER=mock
OPENAI_VISION_MODEL=gpt-4o-mini
# --- Documents (Part 3) -------------------------------------------------------
MAX_DOCUMENT_SIZE_BYTES=10000000
# --- Attachments / multimodal input (Part 8) --------------------------------
# Images: png, jpg/jpeg, webp, gif. Documents: txt, md, csv, json, pdf, docx, xlsx.
# Files are written to a dedicated temp directory (never inside
# AGENT_WORKSPACE_DIR - Desktop Agent tools cannot reach uploaded attachments).
MAX_ATTACHMENT_SIZE_BYTES=10000000
MAX_ATTACHMENTS_PER_MESSAGE=5
MAX_DOCUMENT_PAGES=200
MAX_EXTRACTED_TEXT_CHARS=200000
ATTACHMENT_PROCESSING_TIMEOUT_SECONDS=20
MAX_CONCURRENT_ATTACHMENT_JOBS=4
ATTACHMENT_TTL_SECONDS=3600
ATTACHMENT_CONTEXT_MAX_CHARS=6000
ATTACHMENT_STORAGE_DIR=data/attachments_tmp
# --- Image generation (Part 3) ------------------------------------------------
# One of: none, openai (requires OPENAI_API_KEY above). Defaults to "none":
# generate()/edit() will clearly report "Image generation provider is not
# configured." rather than fabricating an image.
IMAGE_PROVIDER=none
OPENAI_IMAGE_MODEL=dall-e-3
# --- Voice (Part 3, interfaces only - no provider implemented yet) -----------
STT_PROVIDER=none
TTS_PROVIDER=none
# --- CORS (Part 4, so the separate frontend app can call this API) ----------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:4820,http://127.0.0.1:4820,http://localhost:48420,http://127.0.0.1:48420
# --- Auth / sessions --------------------------------------------------------
AUTH_STORE_PATH=data/auth_store.json
AUTH_SESSION_COOKIE_NAME=nexa_session
AUTH_SESSION_TTL_SECONDS=1209600
AUTH_CODE_TTL_SECONDS=900
AUTH_CODE_RESEND_COOLDOWN_SECONDS=60
AUTH_CODE_MAX_ATTEMPTS=5
# Set AUTH_COOKIE_SECURE=true behind HTTPS. For cross-site Electron/dev on
# different hosts you may need AUTH_COOKIE_SAMESITE=none + secure.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
# Leave empty to auto-promote the first verified account (AUTH_BOOTSTRAP_FIRST_OWNER).
# For a public/main release set AUTH_BOOTSTRAP_FIRST_OWNER=false and list only your email.
AUTH_OWNER_EMAILS=
AUTH_BOOTSTRAP_FIRST_OWNER=true
# Single owner mode (default): one account only; no public registration after setup.
AUTH_SINGLE_USER=true
AUTH_SKIP_EMAIL_VERIFICATION=true
# --- Image-to-video (REAL providers only — never mock) ------------------------
# VIDEO_PROVIDER: none | replicate | fal
# Replicate: https://replicate.com/account/api-tokens
# fal.ai:    https://fal.ai/dashboard/keys
VIDEO_PROVIDER=none
REPLICATE_API_TOKEN=
REPLICATE_I2V_MODEL=kwaivgi/kling-v1.6-standard
FAL_KEY=
FAL_I2V_MODEL=fal-ai/minimax/video-01-live
VIDEO_STORAGE_DIR=data/videos
VIDEO_TIMEOUT_SECONDS=600
VIDEO_REQUIRE_ENTITLEMENT=true
# --- Billing / Stripe (REAL payments — never mock) ----------------------------
# Sandbox: https://dashboard.stripe.com/test/apikeys
# Webhook (local): stripe listen --forward-to localhost:8420/api/billing/webhook
BILLING_STORE_PATH=data/billing_store.json
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional Price IDs from Stripe Dashboard (else Checkout uses plans.py amounts).
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_BUSINESS_MONTHLY=
STRIPE_PRICE_BUSINESS_YEARLY=
BILLING_PUBLIC_BASE_URL=http://localhost:4820
BILLING_SALES_EMAIL=sales@nexa.ai
# --- Email (transactional: verification / password reset) -------------------
# EMAIL_PROVIDER: console (logs the message; default for local/dev) | smtp
EMAIL_PROVIDER=console
EMAIL_FROM=noreply@nexa.local
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
# --- Public site (browser + download page) ----------------------------------
# After you buy/connect a domain, set these and redeploy the frontend.
# Example: NEXT_PUBLIC_SITE_URL=https://nexa.example.com
# Download page: https://nexa.example.com/download
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_DOWNLOAD_URL=/downloads/NEXA-Setup.exe
