# =============================================================================
# NEXA — durable PUBLIC production template (no real secrets)
# Copy into the host dashboard / server-only file. NEVER commit filled values.
# Startup refuses unsafe durable settings (see app/config/production_guards.py).
# Free smoke: use .env.render-free.example + render.yaml instead.
# Storage map: docs/STORAGE_MATRIX.md | Edge limits: docs/EDGE_RATE_LIMITING.md
# =============================================================================

ENVIRONMENT=production
LOG_LEVEL=INFO
APP_NAME=NEXA AI
NEXA_STORAGE_MODE=persistent
MEMORY_BACKEND=sql

# SQL: conversations + memory. Prefer volume SQLite or managed Postgres.
# DATABASE_URL=postgresql://USER:PASS@HOST/DB?sslmode=require
DATABASE_URL=sqlite:///data/nexa.db

# --- Auth lockdown (required for public multi-user) ---------------------------
TOKENS_ENFORCE=true
# Set true only after CDN/WAF/reverse-proxy distributed limits are configured.
TRUSTED_EDGE_RATE_LIMIT_ENABLED=false
AUTH_SINGLE_USER=false
AUTH_SKIP_EMAIL_VERIFICATION=false
AUTH_BOOTSTRAP_FIRST_OWNER=false
AUTH_OWNER_EMAILS=you@example.com
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax
AUTH_SESSION_TTL_SECONDS=7776000
AUTH_SESSION_COOKIE_NAME=nexa_session

# Public HTTPS origin (no trailing slash) — same value for CORS / auth / billing
CORS_ALLOWED_ORIGINS=https://YOUR_DOMAIN
AUTH_PUBLIC_BASE_URL=https://YOUR_DOMAIN
BILLING_PUBLIC_BASE_URL=https://YOUR_DOMAIN

# WebAuthn RP id reserved for a future full implementation.
# Passkey LOGIN stays disabled until cryptographic assertion verify ships
# (docs/WEBAUTHN.md). Do not advertise passkeys. AUTH_RP_ID is unused for login.
# AUTH_RP_ID=YOUR_DOMAIN
# AUTH_RP_NAME=NEXA

# --- Email (required when verification is on) ---------------------------------
EMAIL_PROVIDER=smtp
EMAIL_FROM=noreply@YOUR_DOMAIN
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# --- AI (keys server-side only; never NEXT_PUBLIC_*) ---------------------------
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
ALLOW_MODEL_FALLBACK=true
REQUEST_TIMEOUT_SECONDS=90

# Same-origin UI behind Caddy — leave empty in Docker image build
# NEXT_PUBLIC_API_BASE_URL=

# --- JSON / file stores (mount volume at /app/data) ---------------------------
AUTH_STORE_PATH=data/auth_store.json
TOKEN_STORE_PATH=data/token_store.json
PROFILE_STORE_PATH=data/profile_store.json
BILLING_STORE_PATH=data/billing_store.json
KNOWLEDGE_STORE_PATH=data/knowledge_vectors.json
KNOWLEDGE_DOCUMENTS_PATH=data/knowledge_documents.json
PLUGIN_STORE_PATH=data/plugin_store.json
PLUGIN_KEY_PATH=data/plugin.key
PLUGIN_WORKSPACE_DIR=data/plugin_workspaces
AGENT_WORKSPACE_DIR=agent_workspace
ATTACHMENT_STORAGE_DIR=data/attachments_tmp
VIDEO_STORAGE_DIR=data/videos
# MEMORY_STORE_PATH only if MEMORY_BACKEND=json (not recommended for public)

# --- Abuse / spend (in-process; add Cloudflare/nginx edge — see EDGE_RATE_LIMITING)
API_RATE_LIMIT_PER_MINUTE=120
REGISTER_RATE_LIMIT_PER_HOUR=10
FREE_TIER_MODE=false
FREE_TIER_DAILY_CHAT_CAP=50

# --- First public release: workflows are in-memory → keep OFF -----------------
WORKFLOWS_ENABLED=false
WEB_CONCURRENCY=1

# --- Optional integrations ----------------------------------------------------
WEB_SEARCH_PROVIDER=duckduckgo
VISION_PROVIDER=openai
IMAGE_PROVIDER=none
VIDEO_PROVIDER=none
# OAUTH_GOOGLE_CLIENT_ID=
# OAUTH_GOOGLE_CLIENT_SECRET=
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=
