# Copy values into the Railway (or other host) dashboard — do not commit real secrets.
ENVIRONMENT=production
LOG_LEVEL=INFO
APP_NAME=NEXA AI

# Real cloud provider required in production (local Ollama is not reachable from the host).
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional fallback:
# ANTHROPIC_API_KEY=
# ALLOW_MODEL_FALLBACK=true

# Same-origin UI+API behind Caddy — leave blank / unset in the image build.
# NEXT_PUBLIC_API_BASE_URL=

# Persist JSON stores on a volume mounted at /app/data
MEMORY_STORE_PATH=data/memory_store.json
AUTH_STORE_PATH=data/auth_store.json
BILLING_STORE_PATH=data/billing_store.json
AGENT_WORKSPACE_DIR=agent_workspace

# Auth (keep authentication enabled for team access)
AUTH_SINGLE_USER=false
AUTH_SKIP_EMAIL_VERIFICATION=true
AUTH_BOOTSTRAP_FIRST_OWNER=true
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax
AUTH_OWNER_EMAILS=
# EMAIL_PROVIDER=console

# CORS: set to your public HTTPS origin after first deploy, e.g.
# CORS_ALLOWED_ORIGINS=https://nexa-production.up.railway.app
CORS_ALLOWED_ORIGINS=

# Billing optional
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=
# BILLING_PUBLIC_BASE_URL=https://YOUR_PUBLIC_URL

WEB_SEARCH_PROVIDER=duckduckgo
REQUEST_TIMEOUT_SECONDS=90
