# EXAMPLE ONLY — external Nginx edge in front of the NEXA Docker/Caddy container.
# Install as an nginx server config after replacing the hostname and certificate paths.
# NEXA's container must NOT be directly exposed to the Internet; bind Caddy to localhost.
#
# If Cloudflare proxies this host, configure set_real_ip_from for EVERY current
# Cloudflare IPv4/IPv6 range from Cloudflare's official IP list, then set:
#   real_ip_header CF-Connecting-IP;
#   real_ip_recursive on;
# Never trust CF-Connecting-IP / X-Forwarded-For from arbitrary sources.

limit_req_zone $binary_remote_addr zone=nexa_api:20m rate=120r/m;
limit_req_zone $binary_remote_addr zone=nexa_login:10m rate=5r/m;
limit_req_zone $binary_remote_addr zone=nexa_register:10m rate=2r/m;
limit_req_zone $binary_remote_addr zone=nexa_recovery:10m rate=2r/m;

limit_req_status 429;
limit_req_log_level warn;

server {
    listen 80;
    server_name nexa.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name nexa.example.com;

    ssl_certificate     /etc/letsencrypt/live/nexa.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/nexa.example.com/privkey.pem;

    client_max_body_size 12m;

    # Login: general API cap plus a stricter route-specific cap.
    location = /api/v1/auth/login {
        limit_req zone=nexa_api burst=30 nodelay;
        limit_req zone=nexa_login burst=3 nodelay;
        proxy_pass http://127.0.0.1:8080;
        include /etc/nginx/snippets/nexa-proxy-headers.conf;
        proxy_buffering off;
        proxy_read_timeout 120s;
    }

    location = /api/v1/auth/register {
        limit_req zone=nexa_api burst=30 nodelay;
        limit_req zone=nexa_register burst=2 nodelay;
        proxy_pass http://127.0.0.1:8080;
        include /etc/nginx/snippets/nexa-proxy-headers.conf;
    }

    location ~ ^/api/v1/auth/(forgot-password|resend-code)$ {
        limit_req zone=nexa_api burst=30 nodelay;
        limit_req zone=nexa_recovery burst=2 nodelay;
        proxy_pass http://127.0.0.1:8080;
        include /etc/nginx/snippets/nexa-proxy-headers.conf;
    }

    location /api/ {
        limit_req zone=nexa_api burst=30 nodelay;
        proxy_pass http://127.0.0.1:8080;
        include /etc/nginx/snippets/nexa-proxy-headers.conf;
        proxy_buffering off;
        proxy_read_timeout 120s;
    }

    location / {
        proxy_pass http://127.0.0.1:8080;
        include /etc/nginx/snippets/nexa-proxy-headers.conf;
        proxy_read_timeout 120s;
    }
}
