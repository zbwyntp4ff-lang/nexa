# Railway durable / staging host — set in Dashboard Variables (never commit secrets).
# Attach a volume mounted at /app/data (operator action in Railway UI).
# See docs/STAGING_DEPLOYMENT.md, docs/STORAGE_MATRIX.md, .env.staging.example.

NEXA_PUBLIC_BETA=true
ENVIRONMENT=production
NEXA_STORAGE_MODE=persistent
MEMORY_BACKEND=sql
DATABASE_URL=sqlite:///data/nexa-staging.db
TOKENS_ENFORCE=true
WORKFLOWS_ENABLED=false
AUTH_SINGLE_USER=false
AUTH_SKIP_EMAIL_VERIFICATION=false
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax
AUTH_BOOTSTRAP_FIRST_OWNER=false
EMAIL_PROVIDER=smtp
AI_PROVIDER=openrouter
OPENROUTER_MODEL=openai/gpt-4o-mini
ALLOW_MODEL_FALLBACK=false
NEXA_AI_KILL_SWITCH=false
AGENT_MAX_PARALLEL_PER_USER=2
API_RATE_LIMIT_PER_MINUTE=150
REGISTER_RATE_LIMIT_PER_HOUR=150

# Set in Dashboard after domain is known (platform HTTPS URL is fine for staging):
# CORS_ALLOWED_ORIGINS=https://YOUR_SERVICE.up.railway.app
# AUTH_PUBLIC_BASE_URL=https://YOUR_SERVICE.up.railway.app
# BILLING_PUBLIC_BASE_URL=https://YOUR_SERVICE.up.railway.app
# OPENROUTER_API_KEY=   # or OPENAI_API_KEY= with AI_PROVIDER=openai
# SMTP_HOST= SMTP_USERNAME= SMTP_PASSWORD= EMAIL_FROM=
# Leave NEXA_LOCAL_DESKTOP unset.
