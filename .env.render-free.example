# Render FREE TEST — copy values into the Render Dashboard only.
# Never commit real secrets. Do not use as the only copy of real user data:
# Free tier has NO persistent disk; /app/data is wiped on sleep/restart/redeploy.
#
# See DEPLOYMENT.md → "Render Free Test".

ENVIRONMENT=production
LOG_LEVEL=INFO
NEXA_STORAGE_MODE=ephemeral

# Smoke: mock (no cloud AI cost). Real chat: openai + OPENAI_API_KEY in Dashboard.
# Laptop Ollama will NOT work from Render.
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

AUTH_SINGLE_USER=false
AUTH_BOOTSTRAP_FIRST_OWNER=true
AUTH_SKIP_EMAIL_VERIFICATION=true
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax
AUTH_SESSION_TTL_SECONDS=7776000
# Auth required even on free smoke — never leave false on a public URL.
TOKENS_ENFORCE=true
WORKFLOWS_ENABLED=false
EMAIL_PROVIDER=console

# Set AFTER first deploy to the exact https://….onrender.com origin (no trailing slash):
CORS_ALLOWED_ORIGINS=
AUTH_PUBLIC_BASE_URL=
BILLING_PUBLIC_BASE_URL=

VIDEO_PROVIDER=none
IMAGE_PROVIDER=none
VISION_PROVIDER=none
WEB_SEARCH_PROVIDER=duckduckgo
REQUEST_TIMEOUT_SECONDS=60

# Do NOT set Stripe keys on free test (no real payments / custom domain required).
