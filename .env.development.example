# Development — local machine, durable JSON + SQLite under data/
ENVIRONMENT=development
LOG_LEVEL=DEBUG
NEXA_STORAGE_MODE=persistent
DATABASE_URL=sqlite:///data/nexa.db

AI_PROVIDER=mock
# Or local Ollama (optional):
# AI_PROVIDER=ollama
# LOCAL_MODEL_URL=http://127.0.0.1:11434
# LOCAL_MODEL_NAME=llama3.2:3b

TOKENS_ENFORCE=false
AUTH_SKIP_EMAIL_VERIFICATION=true
AUTH_BOOTSTRAP_FIRST_OWNER=true
AUTH_COOKIE_SECURE=false
API_RATE_LIMIT_PER_MINUTE=0
FREE_TIER_MODE=false

CORS_ALLOWED_ORIGINS=http://localhost:4820,http://127.0.0.1:4820
