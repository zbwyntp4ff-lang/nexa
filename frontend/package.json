{
  "name": "frontend",
  "version": "1.0.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev -H :: -p 4820",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "electron": "electron .",
    "electron:build": "node scripts/electron-build.js",
    "dist:electron:icons": "node build/generate-icons.js",
    "dist:electron:linux": "npm run dist:electron:icons && npm run electron:build && electron-builder --linux AppImage",
    "dist:electron:win": "npm run dist:electron:icons && npm run electron:build && electron-builder --win nsis portable"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.78.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.15",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.0",
    "electron": "45.3.3",
    "electron-builder": "26.18.0",
    "eslint": "^10",
    "eslint-config-next": "16.4.6",
    "jsdom": "^31.0.1",
    "png-to-ico": "^3.0.2",
    "tailwindcss": "^4",
    "typescript": "^7",
    "vitest": "^5.1.1",
    "shadcn": "^4.19.0"
  },
  "build": {
    "appId": "ai.nexa.desktop",
    "productName": "NEXA",
    "executableName": "NEXA",
    "copyright": "All rights reserved",
    "directories": {
      "output": "dist-electron",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "package.json",
      "!electron/__tests__/**",
      "!node_modules/**",
      "!out/**"
    ],
    "extraResources": [
      {
        "from": "out",
        "to": "out"
      },
      {
        "from": "../app",
        "to": "backend/app",
        "filter": [
          "**/*.py"
        ]
      },
      {
        "from": "../requirements.txt",
        "to": "backend/requirements.txt"
      },
      {
        "from": "../.venv",
        "to": "backend/.venv",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png",
      "category": "Utility"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "build/icon.png"
    }
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true,
    "electron@45.3.3": true
  },
  "overrides": {
    "minimatch@>=7": "11.0.1"
  }
}
