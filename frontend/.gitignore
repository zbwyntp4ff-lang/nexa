# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
# testing
/coverage
# next.js
/.next/
/out/
# production
# (`/build` used to be ignored wholesale, but `build/generate-icons.js` is a
# real source file for Electron packaging - Part 8.5. Only the generated
# icon binaries are ignored, see below.)
/dist-electron
/build/icon.ico
/build/icon.png
# misc
.DS_Store
*.pem
# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
# env files (.env.example is a template and should be committed)
.env*
!.env.example
# vercel
.vercel
# typescript
*.tsbuildinfo
next-env.d.ts
# testing (Playwright)
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
# auto-generated agent instruction files (regenerated by `next dev`)
AGENTS.md
CLAUDE.md
