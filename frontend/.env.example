# NEXA AI frontend - environment configuration
# Copy this file to `.env.local` and adjust if your backend runs elsewhere.
# Never put API keys here - this frontend never holds provider credentials;
# only the backend (see ../.env.example) does.
# Base URL of the NEXA backend (see ../README.md for how to run it).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8420
