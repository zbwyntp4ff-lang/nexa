# Automated tests / CI — isolated paths, no network AI, no rate limits
ENVIRONMENT=testing
LOG_LEVEL=WARNING
NEXA_STORAGE_MODE=persistent
DATABASE_URL=sqlite:///data/test_nexa.db

AI_PROVIDER=mock
TOKENS_ENFORCE=false
AUTH_SKIP_EMAIL_VERIFICATION=true
AUTH_BOOTSTRAP_FIRST_OWNER=true
API_RATE_LIMIT_PER_MINUTE=0
FREE_TIER_MODE=false
EMAIL_PROVIDER=console
